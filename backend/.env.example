# Database
DATABASE_URL="file:./dev.db"

# Proxy (optional — Node 访问 Gemini 需要，端口以 Clash/系统代理为准)
HTTPS_PROXY="http://127.0.0.1:7897"

# Gemini model (optional)
GEMINI_API_KEY="your-google-gemini-api-key"
# GEMINI_MODEL="gemini-2.5-flash"

# Speech transcription
ASSEMBLYAI_API_KEY="your-assemblyai-api-key"
# Optional: retry failed fixed-language transcription with automatic detection
# Retry backend audio transcription with automatic language detection after the selected language fails.
VOICE_AUTO_LANGUAGE_FALLBACK="false"

# User context cache TTL for AI chat (ms, default 30000)
# CONTEXT_CACHE_TTL_MS=30000

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Email (Resend for general emails)
RESEND_API_KEY=""

# Email verification (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@example.com"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Server
PORT=3001
NODE_ENV="development"
